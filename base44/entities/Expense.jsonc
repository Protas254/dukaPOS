{
  "name": "Expense",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "description": "Expense amount in KES"
    },
    "category": {
      "type": "string",
      "enum": [
        "rent",
        "utilities",
        "salaries",
        "supplies",
        "maintenance",
        "transport",
        "marketing",
        "insurance",
        "taxes",
        "other"
      ],
      "description": "Expense category"
    },
    "description": {
      "type": "string",
      "description": "Description of the expense"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of expense"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mpesa",
        "card",
        "bank_transfer",
        "cheque"
      ],
      "description": "Payment method used"
    },
    "reference_number": {
      "type": "string",
      "description": "Transaction/reference number"
    },
    "receipt_url": {
      "type": "string",
      "description": "URL to receipt image/document"
    },
    "added_by": {
      "type": "string",
      "description": "User ID who added the expense"
    },
    "added_by_name": {
      "type": "string",
      "description": "Name of user who added the expense"
    },
    "shift_id": {
      "type": "string",
      "description": "Linked shift ID (if applicable)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a recurring expense"
    }
  },
  "required": [
    "amount",
    "category",
    "date",
    "payment_method"
  ]
}