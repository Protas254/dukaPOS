{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number"
    },
    "supplier_id": {
      "type": "string",
      "description": "Linked supplier ID"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name (snapshot)"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Date order was created"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Actual delivery date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "confirmed",
        "partially_delivered",
        "delivered",
        "cancelled"
      ],
      "default": "draft",
      "description": "Order status"
    },
    "items": {
      "type": "array",
      "description": "Items ordered",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity_ordered": {
            "type": "number"
          },
          "quantity_received": {
            "type": "number",
            "default": 0
          },
          "unit_cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Total before tax"
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "description": "Tax amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Final total"
    },
    "notes": {
      "type": "string",
      "description": "Order notes"
    },
    "created_by": {
      "type": "string",
      "description": "User ID who created order"
    },
    "created_by_name": {
      "type": "string",
      "description": "Name of user who created order"
    }
  },
  "required": [
    "order_number",
    "supplier_id",
    "supplier_name",
    "order_date",
    "items",
    "total_amount"
  ]
}