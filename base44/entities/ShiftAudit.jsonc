{
  "name": "ShiftAudit",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string",
      "description": "ID of the shift this audit record belongs to"
    },
    "cashier_id": {
      "type": "string",
      "description": "User ID of the cashier"
    },
    "cashier_name": {
      "type": "string",
      "description": "Name of the cashier"
    },
    "audit_type": {
      "type": "string",
      "enum": [
        "cash_discrepancy",
        "manual_adjustment",
        "refund_override",
        "discount_override",
        "void_transaction"
      ],
      "description": "Type of audit event"
    },
    "amount": {
      "type": "number",
      "description": "Amount involved in the discrepancy or adjustment"
    },
    "expected_amount": {
      "type": "number",
      "description": "Expected cash amount (for discrepancies)"
    },
    "actual_amount": {
      "type": "number",
      "description": "Actual cash amount counted (for discrepancies)"
    },
    "reason": {
      "type": "string",
      "description": "Detailed explanation for the discrepancy or adjustment"
    },
    "category": {
      "type": "string",
      "enum": [
        "cash_shortage",
        "cash_overage",
        "manager_approved",
        "system_error",
        "customer_issue",
        "other"
      ],
      "description": "Category of the audit event"
    },
    "requires_approval": {
      "type": "boolean",
      "default": true,
      "description": "Whether this audit requires manager approval"
    },
    "approved_by": {
      "type": "string",
      "description": "User ID of approving manager"
    },
    "approved_by_name": {
      "type": "string",
      "description": "Name of approving manager"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or comments"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when audit was created"
    },
    "sale_id": {
      "type": "string",
      "description": "Linked sale/transaction ID (for refunds, voids, discounts)"
    },
    "sale_receipt_number": {
      "type": "string",
      "description": "Receipt number for reference"
    },
    "sale_amount": {
      "type": "number",
      "description": "Original transaction amount (for refunds/voids/discounts)"
    },
    "original_amount": {
      "type": "number",
      "description": "Original transaction amount (for refunds/voids)"
    },
    "discount_amount": {
      "type": "number",
      "description": "Discount amount applied (for discount overrides)"
    }
  },
  "required": [
    "shift_id",
    "cashier_id",
    "cashier_name",
    "audit_type",
    "reason"
  ]
}