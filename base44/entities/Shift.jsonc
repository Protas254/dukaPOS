{
  "name": "Shift",
  "type": "object",
  "properties": {
    "cashier_id": {
      "type": "string",
      "description": "User ID of the staff member"
    },
    "cashier_name": {
      "type": "string",
      "description": "Name of the staff member"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Shift start timestamp"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "Shift end timestamp (null if active)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active",
      "description": "Whether the shift is currently open"
    },
    "opening_note": {
      "type": "string",
      "description": "Optional note when starting shift"
    },
    "closing_note": {
      "type": "string",
      "description": "Optional note when closing shift"
    },
    "total_sales": {
      "type": "number",
      "default": 0,
      "description": "Cached total revenue for this shift"
    },
    "total_transactions": {
      "type": "number",
      "default": 0,
      "description": "Cached number of transactions for this shift"
    }
  },
  "required": [
    "cashier_id",
    "cashier_name",
    "started_at"
  ]
}