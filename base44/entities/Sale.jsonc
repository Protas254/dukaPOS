{
  "name": "Sale",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "description": "Unique receipt number"
    },
    "shift_id": {
      "type": "string",
      "description": "ID of the staff shift this sale belongs to"
    },
    "cashier_id": {
      "type": "string",
      "description": "User ID of the cashier who processed this sale"
    },
    "customer_id": {
      "type": "string",
      "description": "Linked customer for loyalty tracking"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name (snapshot)"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone (snapshot)"
    },
    "items": {
      "type": "array",
      "description": "Items sold",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "tax_amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Total before tax"
    },
    "tax_total": {
      "type": "number",
      "description": "Total tax amount"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Discount applied"
    },
    "points_earned": {
      "type": "number",
      "default": 0,
      "description": "Loyalty points earned from this sale"
    },
    "total_amount": {
      "type": "number",
      "description": "Final total including tax"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mpesa",
        "card",
        "bank_transfer",
        "cheque",
        "split"
      ],
      "description": "Payment method used"
    },
    "split_payments": {
      "type": "array",
      "description": "Breakdown for split payments",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "mpesa_reference": {
      "type": "string",
      "description": "M-Pesa transaction reference"
    },
    "bank_reference": {
      "type": "string",
      "description": "Bank transfer reference number"
    },
    "cheque_number": {
      "type": "string",
      "description": "Cheque number"
    },
    "cash_received": {
      "type": "number",
      "description": "Cash amount received"
    },
    "change_given": {
      "type": "number",
      "description": "Change returned to customer"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "refunded",
        "voided"
      ],
      "default": "completed"
    },
    "cashier_name": {
      "type": "string",
      "description": "Name of the cashier"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "cuin": {
      "type": "string",
      "description": "KRA eTIMS Control Unit Invoice Number"
    },
    "etims_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "failed"
      ],
      "default": "not_submitted",
      "description": "KRA eTIMS submission status"
    }
  },
  "required": [
    "receipt_number",
    "items",
    "total_amount",
    "payment_method"
  ]
}