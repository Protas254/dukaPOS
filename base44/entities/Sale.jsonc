{
  "name": "Sale",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "description": "Unique receipt number"
    },
    "items": {
      "type": "array",
      "description": "Items sold",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "tax_amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Total before tax"
    },
    "tax_total": {
      "type": "number",
      "description": "Total tax amount"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Discount applied"
    },
    "total_amount": {
      "type": "number",
      "description": "Final total including tax"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mpesa",
        "card",
        "split"
      ],
      "description": "Payment method used"
    },
    "mpesa_reference": {
      "type": "string",
      "description": "M-Pesa transaction reference"
    },
    "cash_received": {
      "type": "number",
      "description": "Cash amount received"
    },
    "change_given": {
      "type": "number",
      "description": "Change returned to customer"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "refunded",
        "voided"
      ],
      "default": "completed"
    },
    "cashier_name": {
      "type": "string",
      "description": "Name of the cashier"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "receipt_number",
    "items",
    "total_amount",
    "payment_method"
  ]
}