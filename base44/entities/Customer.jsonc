{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Customer full name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number (used for lookup)"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0,
      "description": "Accumulated loyalty points"
    },
    "total_spending": {
      "type": "number",
      "default": 0,
      "description": "Total lifetime spending in KES"
    },
    "total_transactions": {
      "type": "number",
      "default": 0,
      "description": "Number of purchases"
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze",
      "description": "Loyalty tier based on spending"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about customer"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether customer account is active"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}