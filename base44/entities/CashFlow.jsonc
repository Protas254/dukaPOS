{
  "name": "CashFlow",
  "type": "object",
  "properties": {
    "transaction_type": {
      "type": "string",
      "enum": [
        "inflow",
        "outflow"
      ],
      "description": "Type of cash flow"
    },
    "category": {
      "type": "string",
      "enum": [
        "sales",
        "expense",
        "loan",
        "investment",
        "transfer",
        "other"
      ],
      "description": "Category of transaction"
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount"
    },
    "description": {
      "type": "string",
      "description": "Description of transaction"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Transaction date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mpesa",
        "card",
        "bank_transfer",
        "cheque"
      ],
      "description": "Payment method"
    },
    "reference_number": {
      "type": "string",
      "description": "Reference/transaction number"
    },
    "linked_sale_id": {
      "type": "string",
      "description": "Linked sale ID (if applicable)"
    },
    "linked_expense_id": {
      "type": "string",
      "description": "Linked expense ID (if applicable)"
    },
    "balance_after": {
      "type": "number",
      "description": "Running balance after this transaction"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "created_by": {
      "type": "string",
      "description": "User ID who recorded transaction"
    }
  },
  "required": [
    "transaction_type",
    "category",
    "amount",
    "date",
    "payment_method"
  ]
}