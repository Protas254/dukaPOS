{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Business/store name"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "individual",
        "sme",
        "enterprise",
        "merchant"
      ],
      "description": "Type/classification of the business"
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "business_address": {
      "type": "string"
    },
    "kra_pin": {
      "type": "string",
      "description": "KRA PIN number"
    },
    "default_tax_rate": {
      "type": "number",
      "default": 16,
      "description": "Default VAT rate"
    },
    "currency": {
      "type": "string",
      "default": "KES"
    },
    "receipt_footer": {
      "type": "string",
      "default": "Thank you for shopping with us!"
    },
    "logo_url": {
      "type": "string"
    },
    "return_policy": {
      "type": "string",
      "description": "Store return & refund policy shown to staff and on receipts"
    },
    "mpesa_paybill": {
      "type": "string",
      "description": "M-Pesa Paybill number (e.g., 174379)"
    },
    "mpesa_till": {
      "type": "string",
      "description": "M-Pesa Buy Goods Till number"
    },
    "mpesa_account": {
      "type": "string",
      "description": "M-Pesa account name to use (e.g., business name)"
    }
  },
  "required": [
    "business_name"
  ]
}