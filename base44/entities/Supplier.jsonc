{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier/business name"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary contact person name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "products_supplied": {
      "type": "string",
      "description": "Description of products they supply"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "cash",
        "net_7",
        "net_15",
        "net_30",
        "credit"
      ],
      "default": "cash",
      "description": "Payment terms"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether supplier is active"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}